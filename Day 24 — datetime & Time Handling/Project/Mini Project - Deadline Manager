import datetime as dt
today=dt.date.today()
assignment=input("Enter your task :")
due_date=input("Enter your due date :")

due_date=dt.datetime.strptime(due_date,"%d-%m-%Y").date()

difference=due_date - today

if difference.days < 0 :
    print("Date passed .",abs(difference.days),"days ago")

elif difference.days == 0:
    print("Today is last day .")

else:
    print(difference.days,"Days Remaining")
